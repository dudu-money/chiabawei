rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 共用清單：知道清單代碼（邀請連結裡那串）的登入者才能加入，成員才看得到店家
    match /lists/{listId} {
      allow get: if signedIn();
      allow list: if signedIn() && request.auth.uid in resource.data.members;

      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.members == [request.auth.uid];

      // 成員可以改清單名稱；任何登入者可以把「自己」加進成員
      allow update: if signedIn() && (
        (request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']))
        ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members)
      );

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /places/{placeId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.members;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.members
          && request.resource.data.addedBy == request.auth.uid;
        allow update, delete: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/lists/$(listId)).data.members;
      }
    }
  }
}
